{
  "name": "@call-a3/eslint-config",
  "version": "1.1.1",
  "description": "The eslint config preferred by Adriaan Callaerts",
  "homepage": "https://github.com/call-a3/eslint-config#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/call-a3/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/call-a3/eslint-config/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adriaan Callaerts",
    "email": "adriaan.callaerts@gmail.com",
    "url": "https://www.adriaan.me"
  },
  "keywords": [
    "eslint",
    "eslintconfig"
  ],
  "main": "index.js",
  "scripts": {
    "test": "echo 'No tests in place yet for this shareable eslint config'",
    "semantic-release": "semantic-release"
  },
  "peerDependencies": {
    "eslint": ">=7.32.0",
    "eslint-plugin-prettier": ">=4.0.0",
    "eslint-plugin-standard": ">=4.1.0"
  },
  "dependencies": {
    "@babel/eslint-parser": "^7.15.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-standard": "^16.0.3"
  },
  "devDependencies": {
    "@call-a3/semantic-release": "^1.0.0-rc.2"
  },
  "release": {
    "branches": [
      "main"
    ],
    "tagFormat": "${version}",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/git",
      "@semantic-release/github"
    ]
  }
}
